<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>__DISPLAY_NAME__ by Animal Audio</title>
    <organization>com.animalaudio</organization>
    <domains enable_anywhere="true" enable_localSystem="true" enable_currentUserHome="true"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="EULA.txt"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="__DISPLAY_NAME__">
        <pkg-ref id="__PKG_ID__"/>
    </choice>
    <pkg-ref id="__PKG_ID__" version="__VERSION__" installKBytes="__INSTALL_KBYTES__" auth="Root">#__SLUG__-component.pkg</pkg-ref>
</installer-gui-script>
