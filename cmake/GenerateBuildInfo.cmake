# Run at build time (cmake -P) by the `aa_build_info` target. Writes OUT only when its content changes,
# so a plain rebuild does not recompile anything.
#
#   -DOUT=<header> -DSOURCE_DIR=<repo> -DVERSION=<x.y.z>
#
# Overrides for builds without a git checkout or for reproducible builds: AA_BUILD_SHA, AA_BUILD_DATE.
# (CMake's string(TIMESTAMP) already honours SOURCE_DATE_EPOCH.)
set(sha "$ENV{AA_BUILD_SHA}")
set(dirty 0)
if(NOT sha)
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} rev-parse --short=7 HEAD
                        OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            set(sha "")
        else()
            execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} status --porcelain --untracked-files=no
                            OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(status)
                set(dirty 1)
            endif()
        endif()
    endif()
endif()
if(NOT sha)
    set(sha "unknown")
endif()

set(date "$ENV{AA_BUILD_DATE}")
if(NOT date)
    string(TIMESTAMP date "%Y-%m-%d" UTC)
endif()

if(NOT DEFINED LOCAL_BUILD)
    set(LOCAL_BUILD OFF)
endif()
if(LOCAL_BUILD)
    set(local_flag 1)
else()
    set(local_flag 0)
endif()

set(content "// Generated by cmake/GenerateBuildInfo.cmake - do not edit.\n#pragma once\n")
string(APPEND content "#define AA_BUILD_VERSION \"${VERSION}\"\n")
string(APPEND content "#define AA_BUILD_GIT_SHA \"${sha}\"\n")
string(APPEND content "#define AA_BUILD_GIT_DIRTY ${dirty}\n")
string(APPEND content "#define AA_BUILD_DATE \"${date}\"\n")
string(APPEND content "#define AA_BUILD_LOCAL ${local_flag}\n")

set(existing "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" existing)
endif()
if(NOT existing STREQUAL content)
    get_filename_component(dir "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${OUT}" "${content}")
endif()
